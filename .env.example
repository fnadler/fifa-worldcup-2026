NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_. Bypasses RLS; used only to
# resolve a /publico/[token] share link to its owner's collection.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — assinatura mensal da loja (use as chaves de TESTE primeiro: sk_test_… / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Meta (Pixel + API de Conversões) — medição dos anúncios. Sem o Pixel ID nada da Meta carrega
# nem dispara, e o site funciona igual.
NEXT_PUBLIC_META_PIXEL_ID=          # ID do Pixel (Gerenciador de Eventos → Fontes de dados)
META_CAPI_ACCESS_TOKEN=             # token da API de Conversões. Só no servidor, NUNCA com NEXT_PUBLIC_
META_TEST_EVENT_CODE=               # opcional: código da aba "Testar eventos" (TEST12345). Deixe vazio em produção
