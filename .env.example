NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_. Bypasses RLS; used only to
# resolve a /publico/[token] share link to its owner's collection.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — assinatura mensal da loja (use as chaves de TESTE primeiro: sk_test_… / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
